# Copy to: config/.env
# Notes:
# - Do NOT commit real secrets.
# - backend loads `config/.env` first, then `.env` at repo root — values are NOT overridden:
#   process environment > config/.env > root .env (root only fills variables still missing)

# ── Microsoft Fabric / Power BI ───────────────────────────
FABRIC_TENANT_ID=
FABRIC_CLIENT_ID=
FABRIC_DATASET_ID=
FABRIC_WORKSPACE_ID=
FABRIC_CLIENT_SECRET=

# ── Entra (Microsoft login for this app) ──────────────────
# If AZURE_AUTH_CLIENT_ID is set, the frontend will require Microsoft login.
# Permissions are resolved via config/user_access.json EMAIL + USERPL — not Fabric ACC_USER_CONTROL.
AZURE_AUTH_CLIENT_ID=
AZURE_AUTH_TENANT_ID=

# ── Deprecated (no longer enforced; kept for old .env compatibility) ──
# AZURE_AUTH_ALLOWED_GROUP_ID=

# Set to 1 to disable Entra login requirement (dev only)
AZURE_AUTH_DISABLED=0

# อีเมลแอดมิน — หน้า「จัดการสิทธิ์」+ เห็นทุกรหัส SL + ส่ง Target Sun
ALLOCATION_ADMIN_EMAILS=

# ── สิทธิ์ผู้ใช้ (แทน ACC_USER_CONTROL / acc_extra_user บน Fabric) ──
USER_ACCESS_JSON_PATH=config/user_access.json
USER_ACCESS_CACHE_TTL_SEC=300
# legacy — ไม่ถูกอ่านในโค้ดแล้ว (เก็บไว้กัน .env เก่า error)
# EXTRA_USER_ACCESS_DISABLED=1

# Cache managers (local JSON — ไม่ดึงจาก Fabric)
MANAGERS_CACHE_TTL_SEC=86400
# Cache ผล GET /data/employees ต่อ (SL, งวด) — ลดการยิง DAX ซ้ำเมื่อสลับมุมมอง (0=ปิด)
EMPLOYEE_PAYLOAD_CACHE_TTL_SEC=3600
# แคช global สินค้า/ราคา Fabric ต่องวด (วินาที, default 24 ชม.)
FABRIC_STATIC_CACHE_TTL_SEC=86400
# Cache รายชื่อพนักงานในหน้าแอดมิน (ว่าง = ใช้ค่า EMPLOYEE_PAYLOAD_CACHE_TTL_SEC)
# ADMIN_TEAM_CACHE_TTL_SEC=900
ENABLE_DEBUG_ENDPOINTS=0
USE_LEGACY_TARGET_CSV=0

# ── โหลดรวมภาค ─────────────────────────────────────────────
# จำนวน thread ที่โหลดข้อมูลหลายทีมพร้อมกัน (เพดาน 8, ไม่เกินจำนวนทีมจริง)
# ตั้ง 1 = กลับไปโหลดทีละทีมแบบเดิม (ใช้ตอนไล่ปัญหา)
# AGGREGATE_LOAD_WORKERS=6

# ── การกระจายหีบ ───────────────────────────────────────────
# ดูกฎทั้งหมดที่ docs/ALLOCATION_INVARIANTS.md
#
# (ALLOC_ALLOW_MISMATCH ถูกถอดออก 29 ก.ย. 2026 — ยอดหีบต่อ SKU ต้องตรงเป้าเสมอ
#  ไม่มีสวิตช์ปล่อยผ่านแล้ว ตั้งไว้ก็ไม่มีผล)
#
# จำกัดหีบของคนที่ไม่มีประวัติขาย SKU นั้น = ceil(เป้า / จำนวนคน * cap)
# เปิดแล้วตัวเลขจะย้ายที่ราว 2-3.5% ต่อทีม — เป็นการตัดสินใจเชิงนโยบาย ต้องแจ้งผู้ใช้ก่อน
# ALLOC_ZERO_BASELINE_CAP=0
#
# บังคับให้ทุก client ส่ง if_match_version ตอนบันทึกผลกระจาย (กัน tab เก่าเขียนทับ)
# เปิดหลังยืนยันว่าไม่มี save_allocation_no_precondition ใน usage log แล้ว
# ALLOC_REQUIRE_IF_MATCH=0

# JSON config paths (optional overrides)
# ACCESS_HIERARCHY_JSON_PATH=config/access_hierarchy.json
# SL_LINKS_JSON_PATH=config/sl_links.json
# SKU_LINKS_JSON_PATH=config/sku_links.json
# APP_RUNTIME_SETTINGS_PATH=config/app_runtime.json

# ── Fabric schema overrides (only if your model differs) ──
TGA_TABLE_NAME=tga_target_salesman_next
TGA_COL_SALESMAN=SALESMANCODE
TGA_COL_PRODUCT=PRODUCTCODE
TGA_COL_QUANTITY=QUANTITYCASE
TGA_COL_EFFECTIVE=EFFECTIVEDATE
# เมื่อ MAX(EFFECTIVEDATE) ว่างทั้งตาราง — ใช้ MAX(col) นี้แทนในการคำนวณงวด snapshot (ปกติ UPDATEDATE)
# ตั้งเป็นค่าว่าง TGA_COL_EFFECTIVE_FALLBACK= เพื่อปิด fallback (เหมือนพฤติกรรมเก่าทั้งหมด)
TGA_COL_EFFECTIVE_FALLBACK=UPDATEDATE
# งวดเป้าที่ implied จาก MAX(EFFECTIVEDATE) (หรือ fallback): same = เดือนเดียวกัน (ค่าเริ่มต้น); next = เดือนถัดไป (พฤติกรรมเก่า)
TGA_EFFECTIVE_IMPLIED_TARGET=same
# 1 = บล็อกงวดเป้าที่เลือกถ้าน้อยกว่างวดที่ snapshot TGA รองรับ
TGA_ENFORCE_EFFECTIVE_WINDOW=1

# ── OneLake / Lakehouse upload (optional) ─────────────────
# ใช้ FABRIC_TENANT_ID / FABRIC_CLIENT_ID / FABRIC_CLIENT_SECRET ขอ token (storage scope) เพื่ออัปโหลดไฟล์เข้า OneLake
# ต้องเป็น GUID (รูปแบบ xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx) เท่านั้น — อย่าใส่ชื่อ Workspace/Lakehouse;
# ถ้าได้ error FriendlyNameSupportDisabled แปลว่าต้องเปลี่ยนจากชื่อเป็นค่า Id จาก Fabric URL / Properties
ONELAKE_WORKSPACE_ID=
ONELAKE_LAKEHOUSE_ID=
# โฟลเดอร์ปลายทางใน Lakehouse (ภายใต้ Files/)
ONELAKE_UPLOAD_DIR=Files/target_allocation_uploads
# คอลัมน์ dim ใน semantic model สำหรับ export รูปแบบ TGA (ให้ตรงกับตารางเป้าใน Power BI)
LAKEHOUSE_COL_SALESTYPE=SALESTYPE
LAKEHOUSE_COL_DIVISION=DIVISIONCODE
LAKEHOUSE_COL_AREACODE=AREACODE
LAKEHOUSE_COL_PROVINCE=PROVINCECODE
LAKEHOUSE_COL_WAREHOUSE=WAREHOUSECODE
# หลัง GET /data/employees จะสร้าง data/tga_lines_{sup}_{ปี}_{เดือน}.csv จาก tga_target_salesman_next (grain เต็ม) — ใช้แตกบรรทัด Excel TGA
# SALESTYPE / DIVISIONCODE ว่างได้ถ้า TGA ไม่มีค่า — USERCODE ส่งจากแอป (รหัส manager หรือ supervisor)

# ── Server data paths (production) ────────────────────────
# ALLOCATIONS_DATA_DIR=/var/lib/allocation_target/allocations
# USAGE_LOGS_DIR=/var/lib/allocation_target/logs
# FABRIC_CACHE_DIR=/var/lib/allocation_target/cache
# BUILD_VERSION=optional-git-hash-for-footer-without-git-binary
# GIT_COMMIT=   (ใช้แทน BUILD_VERSION ได้ ถ้า CI ตั้งให้)
#
# ── ไฟล์ที่แอปเขียนตอนรัน — ค่าเริ่มต้นอยู่ในโฟลเดอร์ repo ตั้งเฉพาะถ้าต้องการย้ายออกนอก repo
#    (เช่นให้รอดการ deploy แบบสลับโฟลเดอร์) · ไม่ตั้ง = ใช้ค่าเริ่มต้นในวงเล็บ
# ADMIN_PERMISSIONS_JSON_PATH=     (config/admin_permissions.json)
# ALLOC_RULES_JSON_PATH=           (config/allocation_rules.json — ค่าตั้งต้นใน git)
# ALLOC_RULES_OVERRIDE_PATH=       (data/alloc_rules.json — ค่าที่แอดมินตั้งจากหน้าเว็บ)
# EMP_ASSIGNMENTS_JSON_PATH=       (config/emp_assignments.json)
# NO_TARGET_EMPLOYEES_JSON_PATH=   (config/no_target_employees.json)
# WAREHOUSE_PIN_RULES_PATH=        (data/warehouse_pin_rules.json)
# FEEDBACK_DIR=                    (data/feedback)
# NOTIFICATIONS_DIR=               (data/notifications)
#
# ── อื่น ๆ
# ACC_USER_CONTROL_CACHE_TTL_SEC=300     แคชสิทธิ์ผู้ใช้ (วินาที)
# AZURE_AUTH_JWKS_URI_CACHE_SEC=3600     แคช URI ของกุญแจ Entra (วินาที)
# WEB_CONCURRENCY=1   ห้ามเกิน 1 — ล็อกในแอปเป็นระดับโปรเซส (docs/CONCURRENCY.md) · แอปตรวจเองด้วย
#                     data/.app_process.lock แล้วเตือนใน log และ /health (runtime.single_process)
# URL ตั้งใน backend/services/targetsun_endpoints.py (ไม่ใช้ .env)
TARGETSUN_IMPORT_TIMEOUT_SEC=600
# เซิร์ฟวิทย์ภายใน — ถ้า SSL มีปัญหา: TARGETSUN_IMPORT_VERIFY_SSL=0 (ไม่แนะนำ production)
# TARGETSUN_IMPORT_VERIFY_SSL=1
# ถ้า API ต้องการ header (เช่น Bearer): ใส่ทั้งบรรทัดหรือแค่ token
# TARGETSUN_IMPORT_AUTH_HEADER=

# ── TargetSun Read API — ดึงเป้าหีบจาก Oracle โดยตรง (แทน semantic model TGA)
# Base URL ตั้งใน backend/services/targetsun_endpoints.py (ไม่ใช้ .env)
# เอกสาร: docs/TARGETSUN_READ_API_SPEC.md
# เปิดใช้ = 1 (ค่าเริ่มต้นเปิด — ปิดชั่วคราวด้วย 0 หรือสลับเป็น Fabric ในแอดมิน)
TARGETSUN_READ_ENABLED=1
TARGETSUN_READ_TIMEOUT_SEC=120
# ถ้า Read API ล่ม กลับไปใช้ Fabric TGA อัตโนมัติ
TARGETSUN_READ_FALLBACK_FABRIC=1
# TARGETSUN_READ_VERIFY_SSL=1
# TARGETSUN_READ_AUTH_HEADER=
